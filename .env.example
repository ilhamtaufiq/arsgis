# Salin ke .env untuk pengembangan lokal. Jangan commit .env.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/arsgis_dev
PORT=8080
WEB_DIST=web/dist
RUST_LOG=pipa_api=info,tower_http=info
# Wajib, minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
JWT_SECRET=
# Set true di produksi (HTTPS) agar cookie sesi hanya dikirim lewat TLS.
COOKIE_SECURE=false
# Sinkron data SPM air minum dari Arumanis (baca saja).
ARUMANIS_API_URL=https://apiamis.cianjur.space/api
# Token akun Arumanis khusus baca untuk unit SPAM dan Pokmas. Tanpa token, hanya desa dan capaian yang disinkron.
# Boleh disalin dari cookie (id%7Crahasia); otomatis diubah ke bentuk id|rahasia.
ARUMANIS_TOKEN=
# Jeda sinkron otomatis dalam menit. 0 mematikan sinkron otomatis.
ARUMANIS_SYNC_MENIT=60
# Admin awal dibuat otomatis saat server pertama kali jalan (jika belum ada). Kata sandi wajib diisi di server, jangan commit.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
